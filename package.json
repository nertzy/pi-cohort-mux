{
  "name": "pi-cohort-mux-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.mjs test/*.test.mjs",
    "check": "npm run lint && npm test",
    "lint": "npm run lint:biome && npm run lint:markdown && actionlint .github/workflows/*.yml",
    "lint:biome": "biome check --error-on-warnings .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#tmp\" \"#.worktrees\"",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#tmp\" \"#.worktrees\"",
    "pack:check": "node scripts/check-package-contents.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-tui": "1.3.0",
    "jiti": "^2.7.0",
    "markdownlint-cli2": "^0.24.0",
    "pi-cohort": "7.4.1"
  },
  "overrides": {
    "katex": "^0.18.2",
    "re2js": "^2.8.7"
  }
}
